# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 절대 커밋하지 않습니다.
# Render 에 배포할 때는 이 목록을 Environment Variables 에 그대로 등록합니다.

# ── Supabase (Project Settings → API) ────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=여기에-anon-public-키
SUPABASE_SERVICE_ROLE_KEY=여기에-service_role-키   # 서버 전용. 절대 외부 노출 금지

# ── Gemini (aistudio.google.com/apikey) ──────────────────────────────
GEMINI_API_KEY=여기에-API-키

# ── Redis (Redis Cloud → Databases → Connect) ────────────────────────
REDIS_HOST=your-endpoint.redis-cloud.com
REDIS_PORT=12345
REDIS_PASSWORD=여기에-비밀번호
# 관리형 Redis 가 TLS 접속을 요구하면 true. 로컬이나 평문 접속이면 비워 두거나 false.
REDIS_SSL=false
